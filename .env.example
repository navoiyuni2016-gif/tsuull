# Real credentials are generated ON THE VM by deploy/install.sh.
# Never commit .env or transfer another environment's secrets.
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=
MFA_ENCRYPTION_KEY=
ERP_DOMAIN=el.tsuull.uz
TARGET_SERVER_IP=172.20.0.50
BIND_ADDRESS=172.20.0.50
ERP_HTTP_PORT=80
ERP_HTTPS_PORT=443
# Set a real administrator contact for public ACME mode. Not needed in proxy/cert mode.
ACME_EMAIL=
# In proxy mode this is loopback by default; expose a LAN address only to an authorized external proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080

# Optional LOCAL university model on a SEPARATE server; disabled until both are set.
# See docs/19-REJA-USTAXONASI-VA-AI.md. No external AI API key is used.
LOCAL_AI_URL=
LOCAL_AI_MODEL=
LOCAL_AI_NO_PROXY=db,localhost,127.0.0.1
